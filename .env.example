# ─────────────────────────────────────────────────────────────
# EB Bot — environment configuration
# Copy to .env and fill in.  NEVER commit the real .env.
# Requires Node 22+ (@discordjs/voice needs >=22.12.0).
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ── Ownership / developer access ──────────────────────────────
# Your Discord user ID. Grants Admin everywhere + unlocks /api/dev.
OWNER_ID=
# Unlocks the Developer page. Use 32+ random chars, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_TOKEN=

# ── SECURITY — READ THIS ──────────────────────────────────────
# Authentication is enforced by default. Setting this to "false" enables a
# development-only bypass for direct loopback requests; forwarded/tunnelled
# requests remain locked and production refuses to start with the bypass.
# OAuth requires CLIENT_ID + DISCORD_CLIENT_SECRET below.
DASHBOARD_AUTH=true

# Session signing secret. If unset, sessions reset on every restart.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Discord OAuth (required when DASHBOARD_AUTH=true) ─────────
# From Developer Portal → OAuth2. Undocumented in the README.
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI registered in the portal exactly.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
# Optional additional trusted browser origin for CSRF validation.
DASHBOARD_ORIGIN=
# "true" forces the Secure cookie flag — enable when served over HTTPS.
DASHBOARD_SECURE=false

# ── Storage ───────────────────────────────────────────────────
# Defaults to database/json.sqlite. Override only with an absolute deployment path.
DATABASE_PATH=

# ── Command deployment ────────────────────────────────────────
# Target guild for instant command registration. Empty = global (~1h).
GUILD_ID=
# "true" re-registers slash commands on boot.
DEPLOY_COMMANDS=false
SYNC_GLOBAL_COMMANDS=false

# ── Production ────────────────────────────────────────────────
# Set to "production" when deploying. This makes the server REFUSE to start
# unless SESSION_SECRET is set and DASHBOARD_AUTH is not disabled, and forces
# the Secure flag on the session cookie.
NODE_ENV=

# ── Misc ──────────────────────────────────────────────────────
LOG_LEVEL=info
SUPPORT_INVITE=
