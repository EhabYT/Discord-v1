# Secrets — never commit
.env
.env.*
!.env.example

# Runtime database (contains real guild/user IDs & moderation records)
json.sqlite
json.sqlite-journal
json.sqlite-wal
json.sqlite-shm
*.sqlite

# Runtime logs & tunnel state
logs/*
!logs/.gitkeep
.dashboard-url
PUBLIC_DASHBOARD.txt

# Dependencies
node_modules/
dashboard/node_modules/

# Build output — uncomment if you build the SPA during deploy
# dashboard/public/assets/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Scratch/probe files used while debugging. A throwaway probe was committed
# during the audit because a cleanup command was interrupted; this makes that
# class of mistake impossible rather than relying on remembering to delete.
_*.js
!_app.js
*.bak
*.orig
