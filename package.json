{
  "name": "discord-bot",
  "version": "3.1.0",
  "description": "Powerful Discord Bot featuring Moderation, AutoMod, Utilities & Music playback.",
  "author": "EB-Bot Team",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node index.js",
    "rebuild": "npm rebuild better-sqlite3",
    "postinstall": "npm rebuild better-sqlite3",
    "deploy": "node -e \"require('dotenv').config(); require('./utils/startup').deployCommands(process.env.DISCORD_TOKEN, process.env.CLIENT_ID, process.env.GUILD_ID || null)\"",
    "dashboard": "node dashboard/server.js",
    "dev": "nodemon index.js",
    "build:dashboard": "npm --prefix dashboard/client run build"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discord-player/opus": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.5",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "discord-player": "^7.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "genius-lyrics": "^4.4.7",
    "mediaplex": "^1.0.0",
    "play-dl": "^1.9.7",
    "quick.db": "^9.1.7",
    "socket.io": "^4.8.3",
    "spotify-url-info": "^3.3.2",
    "youtube-ext": "^1.1.25"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
